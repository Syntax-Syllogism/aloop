{
  "name": "@syntax-syllogism/aloop",
  "version": "0.12.1",
  "description": "Syntax & Syllogism agentic loop runner.",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./backends/github": "./src/publish.mjs",
    "./backends/gitlab": "./src/backends/gitlab.mjs",
    "./src/*": "./src/*"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aloop": "bin/loop.mjs",
    "aloop-eval": "bin/eval.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "prompts",
    "examples",
    "presets",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agentic",
    "loop",
    "code-review",
    "claude",
    "codex",
    "antigravity",
    "gemini",
    "opencode",
    "cli"
  ],
  "homepage": "https://github.com/Syntax-Syllogism/aloop#readme",
  "bugs": {
    "url": "https://github.com/Syntax-Syllogism/aloop/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syntax-Syllogism/aloop.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/node": "^22.20.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "smol-toml": "^1.9.1"
  }
}
